# ===== Database =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vetri_db
DB_USER=root
DB_PASSWORD=

# ===== App secret (generate any long random string yourself, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`) =====
SECRET_KEY=change_this_to_a_random_secret

# ===== Google Sign-In (OAuth) =====
# Get from https://console.cloud.google.com/apis/credentials -> OAuth Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== Gemini (article generation / cleanup) - OPTIONAL =====
# Free key from https://aistudio.google.com/apikey
# If left empty, the app falls back to TextRank-only extractive summary (still works, just less polished).
GEMINI_API_KEY=

# ===== Whisper fallback transcription (runs locally, no API key) =====
# Used automatically when a video has no YouTube captions available.
# Requires ffmpeg installed and on PATH (apt install ffmpeg / brew install ffmpeg).
WHISPER_FALLBACK_ENABLED=true
# tiny/base/small/medium/large-v3 — bigger = more accurate but slower on first run
# (model weights download once, then run fully offline).
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ===== Translation & Dubbing Flags =====
# Set ENABLE_NLLB=true to use Meta NLLB-200 model as primary translation path (requires transformers/torch)
ENABLE_NLLB=false

# Set ENABLE_SEAMLESS_M4T=true to use Meta SeamlessM4T for primary dubbing (requires GPU/high VRAM)
ENABLE_SEAMLESS_M4T=false

# Dubbing engine selection: 'gtts_fallback' (default, lightweight) or 'seamless_m4t'
DUBBING_ENGINE=gtts_fallback

# ===== Frontend URL (for CORS) =====
FRONTEND_URL=http://localhost:5173
